
Процедура Печать(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.ВыдачаКниги.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыдачаКниги.Библиотекарь,
	|	ВыдачаКниги.Дата,
	|	ВыдачаКниги.ДатаВозврата,
	|	ВыдачаКниги.ДатаВыдачи,
	|	ВыдачаКниги.Номер,
	|	ВыдачаКниги.Читатель,
	|	ВыдачаКниги.Книги.(
	|		НомерСтроки,
	|		Книга,
	|		Количество
	|	)
	|ИЗ
	|	Документ.ВыдачаКниги КАК ВыдачаКниги
	|ГДЕ
	|	ВыдачаКниги.Ссылка В (&Ссылка)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьКнигиШапка = Макет.ПолучитьОбласть("КнигиШапка");
	ОбластьКниги = Макет.ПолучитьОбласть("Книги");
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьКнигиШапка);
		ВыборкаКниги = Выборка.Книги.Выбрать();
		Пока ВыборкаКниги.Следующий() Цикл
			ОбластьКниги.Параметры.Заполнить(ВыборкаКниги);
			ТабДок.Вывести(ОбластьКниги, ВыборкаКниги.Уровень());
		КонецЦикла;

		Подвал.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры
