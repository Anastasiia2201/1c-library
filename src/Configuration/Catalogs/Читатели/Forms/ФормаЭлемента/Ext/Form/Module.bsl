&НаСервере 
Процедура ОпределитьКарту() 
	Координаты = Новый Массив;
	Координаты = ЯндексКарты.ПолучитьКоординатыМеста(Объект.Адрес);
	Если СтрДлина(Координаты) > 1 Тогда
		Результат = СтрРазделить(Координаты, " ");	
		КартаHTML = ПолучитьКарту(8,, Результат); 
	Иначе
		КартаHTML = ПолучитьКарту(8,,);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОпределитьКарту();
КонецПроцедуры
