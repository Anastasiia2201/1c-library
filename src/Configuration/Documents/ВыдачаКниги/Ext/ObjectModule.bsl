
Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр КнигиВБиблиотеке Приход
	Движения.КнигиВБиблиотеке.Записывать = Истина;
	Для Каждого ТекСтрокаКниги Из Книги Цикл
		Движение = Движения.КнигиВБиблиотеке.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Книга = ТекСтрокаКниги.Книга;
		Движение.Количество = ТекСтрокаКниги.Количество;
	КонецЦикла;
	
	Движения.Посещаемость.Записывать = Истина;
	Движение = Движения.Посещаемость.Добавить();
	Движение.Период = ДатаВыдачи;
	Движение.Читатель = Читатель;
	Движение.КоличествоПосещений = 1;

		// регистр ВыданныеКниги
	Движения.ВыданныеКниги.Записывать = Истина;
	Для Каждого ТекСтрокаКниги Из Книги Цикл
		Движение = Движения.ВыданныеКниги.Добавить();
		Движение.Книга = ТекСтрокаКниги.Книга;
		Движение.Читатель = Читатель;
		Движение.ДатаВозврата = ДатаВозврата;
		Движение.ДатаВыдачи = ДатаВыдачи;
		Движение.Статус =  "Выдана";
		Движение.Количество =  ТекСтрокаКниги.Количество;
	КонецЦикла; 
	
	Движения.Записать();
	
   Если Режим = РежимПроведенияДокумента.Оперативный Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КнигиВБиблиотекеОстатки.Книга КАК Книга,
		|	КнигиВБиблиотекеОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.КнигиВБиблиотеке.Остатки(
		|			,
		|			Книга В
		|				(ВЫБРАТЬ
		|					ВыдачаКнигиКниги.Книга КАК Книга
		|				ИЗ
		|					Документ.ВыдачаКниги.Книги КАК ВыдачаКнигиКниги)) КАК КнигиВБиблиотекеОстатки
		|ГДЕ
		|	КнигиВБиблиотекеОстатки.КоличествоОстаток < 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если Не РезультатЗапроса.Пустой() Тогда
	    Отказ = Истина;
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл	
			Сообщить("Недостаточно книг " + ВыборкаДетальныеЗаписи.Книга + " в количестве " + (-ВыборкаДетальныеЗаписи.КоличествоОстаток));
		 КонецЦикла;
			
	КонецЕсли;
	
   КонецЕсли;

КонецПроцедуры
